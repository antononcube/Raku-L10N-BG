# ФизБаз. Първият ред е единствения, който не трябва да се напише на български:
# жаргона (сленг) все още не е зареден, докато реда `use` не е изпъленен.
#
#     RAKUDO_RAKUAST=1 rakudo -I lib examples/fizzbuzz.raku   # Rakudo
#     rakupp -I lib examples/fizzbuzz.raku                    # Raku++
#
# Чрез `bulku` този файл не се стартира: този изпълнител зережда жаргона до
# парсирането на кода, и тогава `use` в перия ред трябва да се напише като `използвай`.

use L10N::BG;

за 1..20 -> $н {
    дадено $н {
        когато $_ %% 15 { кажи "ФизБаз" }
        когато $_ %% 3  { кажи "Физ"    }
        когато $_ %% 5  { кажи "Баз"    }
        умълчано        { кажи $н       }
    }
}
